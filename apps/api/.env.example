# Copy to .env for local or server use.
# Production: set NODE_ENV=production and fill every required secret below.

NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/SHADOW_DATABASE?schema=public"

# Long random secrets (≥32 chars). In production each must be unique and non-placeholder.
JWT_SECRET="replace-with-a-long-random-secret"
# Separate stable secret before enabling authenticator enrollment in production.
# Without it, local development derives the encryption key from JWT_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=
# Separate 32+ character secret used to encrypt active OTC transaction keys.
OTC_KEY_ENCRYPTION_SECRET="replace-with-a-different-long-random-secret"

# First-time staff passwords (≥12 chars). Seed only sets them on CREATE;
# re-running seed does not overwrite existing password hashes.
ADMIN_INITIAL_PASSWORD=""
FINANCE_INITIAL_PASSWORD=""
SUPPORT_INITIAL_PASSWORD=""
BUSINESS_INITIAL_PASSWORD=""
MANAGER_INITIAL_PASSWORD=""

# Strong unique invite code for admin-controlled registration (≥12 chars).
# Required when NODE_ENV=production.
ADMIN_FIXED_INVITE_CODE=""

# KYC documents are private. Mount PRIVATE_OBJECT_ROOT on encrypted durable
# storage, use a unique signing secret, and configure an HTTPS malware scanner.
PRIVATE_OBJECT_ROOT="private-objects"
OBJECT_SIGNING_SECRET="replace-with-a-third-independent-random-secret"
# Required HTTPS scanner in production. Uploads fail closed when missing.
VIRUS_SCAN_URL=""

# Google OAuth Web client ID. Use the same value for the Flutter
# --dart-define=GOOGLE_CLIENT_ID=... build setting.
GOOGLE_CLIENT_ID=

# HTTPS endpoint that accepts { phone, message } for password-reset OTP SMS.
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# Optional SaleSmartly / CMS script URL fallback used by app content.
SALESMARTLY_SCRIPT_URL=

# Comma-separated origins allowed to call the API (credentials + cookies).
# Production: HTTPS only — include all five admin origins and optional app origin.
# Example: https://admin.example.com,https://manager.example.com,https://finance.example.com,https://business.example.com,https://operator.example.com,https://app.example.com
CORS_ORIGINS="http://localhost:3002,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3000"

HOST=0.0.0.0
PORT=3000
# Maximum simultaneous Socket.IO connections accepted for one authenticated user.
WS_MAX_CONNECTIONS_PER_USER=5
MATCHING_MAX_FILL_QUANTITY=1000
UPSTOX_ACCESS_TOKEN=

# NSE equity normal-market lifecycle (IST).
MARKET_OPEN_TIME_IST=09:15
MARKET_CLOSE_TIME_IST=15:30
# Maintain this comma-separated YYYY-MM-DD list from the exchange holiday calendar.
MARKET_HOLIDAYS_IST=
DAY_ORDER_EXPIRY_BATCH_SIZE=500

# Snapshot / polling market data provider.
MARKET_DATA_PROVIDER=YAHOO
# Maximum active ordinary stocks refreshed in each 10-second polling cycle.
MARKET_DATA_POLL_BATCH_SIZE=24

# Streaming market data remains disabled by default.
MARKET_DATA_STREAMING_ENABLED=false
MARKET_DATA_STREAMING_PROVIDER=NONE
MARKET_DATA_RECONNECT_MS=5000
MARKET_DATA_STALE_AFTER_MS=60000
# Optional comma-separated HTTPS RSS feeds. When blank, the server aggregates
# credential-free NSE announcements, SEBI updates and Indian market headlines.
MARKET_NEWS_RSS_URLS=""

# TrueData streaming configuration.
# Install the optional official truedata-nodejs SDK before selecting TRUEDATA.
TRUEDATA_USER=
TRUEDATA_PASSWORD=
TRUEDATA_PORT=8082
TRUEDATA_URL=push
TRUEDATA_BIDASK=true
TRUEDATA_HEARTBEAT=true
TRUEDATA_REPLAY=false
TRUEDATA_SYMBOL_LIMIT=200
TRUEDATA_SUBSCRIBE_BATCH_SIZE=50
