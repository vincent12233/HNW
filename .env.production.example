# Copy these names into Coolify's Environment Variables screen.
# Never commit real values. Generate every secret independently.
NODE_ENV=production
PUBLIC_API_URL=https://api.your-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DB_HOST:5432/hnw?schema=public
RATE_LIMIT_REDIS_URL=redis://PRIVATE_REDIS_HOST:6379
TRUST_PROXY_HOPS=1
PRIVATE_OBJECT_HOST_PATH=/srv/hnw/private-objects
JWT_SECRET=GENERATE_UNIQUE_32_PLUS_CHARACTERS
TWO_FACTOR_ENCRYPTION_KEY=GENERATE_ANOTHER_UNIQUE_32_PLUS_CHARACTERS
OTC_KEY_ENCRYPTION_SECRET=GENERATE_ANOTHER_UNIQUE_32_PLUS_CHARACTERS
OBJECT_SIGNING_SECRET=GENERATE_ANOTHER_UNIQUE_32_PLUS_CHARACTERS
ADMIN_FIXED_INVITE_CODE=GENERATE_UNIQUE_12_PLUS_CHARACTERS
ADMIN_INITIAL_PASSWORD=GENERATE_UNIQUE_12_PLUS_CHARACTERS
MANAGER_INITIAL_PASSWORD=GENERATE_UNIQUE_12_PLUS_CHARACTERS
FINANCE_INITIAL_PASSWORD=GENERATE_UNIQUE_12_PLUS_CHARACTERS
BUSINESS_INITIAL_PASSWORD=GENERATE_UNIQUE_12_PLUS_CHARACTERS
SUPPORT_INITIAL_PASSWORD=GENERATE_UNIQUE_12_PLUS_CHARACTERS
CORS_ORIGINS=https://admin.your-domain.example,https://manager.your-domain.example,https://finance.your-domain.example,https://business.your-domain.example,https://operator.your-domain.example
MARKET_DATA_PROVIDER=LICENSED_PROVIDER_NAME
VIRUS_SCAN_URL=https://scanner.your-domain.example/scan
VIRUS_SCAN_BEARER_TOKEN=
GOOGLE_CLIENT_ID=
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=
SALESMARTLY_SCRIPT_URL=
ERROR_REPORT_WEBHOOK_URL=
ERROR_REPORT_WEBHOOK_TOKEN=
MARKET_DATA_STREAMING_ENABLED=false
MARKET_DATA_STREAMING_PROVIDER=NONE
MARKET_NEWS_RSS_URLS=
MARKET_HOLIDAYS_IST=
GIT_COMMIT=SET_BY_DEPLOYMENT
BUILD_TIME=SET_BY_DEPLOYMENT
