generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountTransactionType {
  DEPOSIT
  WITHDRAWAL
  ADMIN_CREDIT
  ADMIN_DEBIT
  ORDER_FREEZE
  ORDER_RELEASE
  TRADE_SETTLEMENT
}

enum AccountTransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id                         String               @id @default(uuid())
  email                      String               @unique
  passwordHash               String
  fullName                   String
  phone                      String?
  role                       UserRole             @default(CLIENT)
  status                     UserStatus           @default(ACTIVE)
  account                    Account?
  createdAccountTransactions AccountTransaction[] @relation("TransactionCreator")
  auditLogs                  AuditLog[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@map("users")
}

model Account {
  id              String               @id @default(uuid())
  accountNumber   String               @unique
  cashBalance     Decimal              @default(0) @db.Decimal(18, 2)
  buyingPower     Decimal              @default(0) @db.Decimal(18, 2)
  frozenBalance   Decimal              @default(0) @db.Decimal(18, 2)
  currency        String               @default("INR")
  isSandbox       Boolean              @default(true)
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    AccountTransaction[]
  orders          Order[]
  trades          Trade[]
  positions       Position[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  ipoApplications IpoApplication[]

  @@map("accounts")
}

model AccountTransaction {
  id            String                   @id @default(uuid())
  accountId     String
  account       Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          AccountTransactionType
  status        AccountTransactionStatus @default(PENDING)
  amount        Decimal                  @db.Decimal(18, 2)
  balanceBefore Decimal                  @db.Decimal(18, 2)
  balanceAfter  Decimal                  @db.Decimal(18, 2)
  referenceId   String?                  @unique
  note          String?
  createdById   String?
  createdBy     User?                    @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([accountId, createdAt])
  @@index([status])
  @@map("account_transactions")
}

enum Exchange {
  NSE
  BSE
}

enum InstrumentType {
  EQUITY
  ETF
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum TimeInForce {
  DAY
  IOC
  FOK
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

model Instrument {
  id       String         @id @default(uuid())
  symbol   String
  exchange Exchange
  name     String
  isin     String?
  type     InstrumentType @default(EQUITY)
  currency String         @default("INR")
  lotSize  Int            @default(1)
  tickSize Decimal        @default(0.05) @db.Decimal(10, 2)
  isActive Boolean        @default(true)

  quote     MarketQuote?
  orders    Order[]
  trades    Trade[]
  positions Position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([exchange, symbol])
  @@index([symbol])
  @@index([isin])
  @@index([isActive])
  @@map("instruments")
}

model MarketQuote {
  id           String     @id @default(uuid())
  instrumentId String     @unique
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  lastPrice     Decimal  @db.Decimal(18, 4)
  openPrice     Decimal? @db.Decimal(18, 4)
  highPrice     Decimal? @db.Decimal(18, 4)
  lowPrice      Decimal? @db.Decimal(18, 4)
  previousClose Decimal? @db.Decimal(18, 4)
  bidPrice      Decimal? @db.Decimal(18, 4)
  askPrice      Decimal? @db.Decimal(18, 4)
  volume        BigInt   @default(0)
  source        String   @default("SANDBOX")
  asOf          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([asOf])
  @@map("market_quotes")
}

model Order {
  id            String     @id @default(uuid())
  clientOrderId String
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id])

  side             OrderSide
  type             OrderType
  timeInForce      TimeInForce @default(DAY)
  status           OrderStatus @default(PENDING)
  quantity         Int
  filledQuantity   Int         @default(0)
  limitPrice       Decimal?    @db.Decimal(18, 4)
  averageFillPrice Decimal?    @db.Decimal(18, 4)
  frozenAmount     Decimal     @default(0) @db.Decimal(18, 2)
  rejectionReason  String?

  trades Trade[]

  placedAt    DateTime  @default(now())
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, clientOrderId])
  @@index([accountId, status, placedAt])
  @@index([instrumentId, status])
  @@map("orders")
}

model Trade {
  id           String     @id @default(uuid())
  executionId  String     @unique
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  quantity    Int
  price       Decimal  @db.Decimal(18, 4)
  grossAmount Decimal  @db.Decimal(18, 2)
  fees        Decimal  @default(0) @db.Decimal(18, 2)
  netAmount   Decimal  @db.Decimal(18, 2)
  executedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([accountId, executedAt])
  @@index([instrumentId, executedAt])
  @@index([orderId])
  @@map("trades")
}

model Position {
  id           String     @id @default(uuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  quantity       Int     @default(0)
  frozenQuantity Int     @default(0)
  averagePrice   Decimal @default(0) @db.Decimal(18, 4)
  realizedPnl    Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, instrumentId])
  @@index([accountId])
  @@map("positions")
}

model AuditLog {
  id String @id @default(uuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  resource   String
  resourceId String?

  description String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Ipo {
  id String @id @default(uuid())

  symbol      String
  companyName String

  exchange Exchange

  issuePrice Decimal @db.Decimal(18, 2)
  lotSize    Int

  totalShares     Int
  availableShares Int

  openDate  DateTime
  closeDate DateTime

  status IpoStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications IpoApplication[]

  @@index([status])
  @@index([openDate])
  @@index([closeDate])
  @@map("ipos")
}

model IpoApplication {
  id String @id @default(uuid())

  ipoId String
  accountId String

  status IpoApplicationStatus @default(PENDING)

  allocatedQuantity Int?

  allocatedPrice Decimal? @db.Decimal(18, 2)

  allocatedAmount Decimal? @db.Decimal(18, 2)

  paymentStatus IpoPaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  ipo Ipo @relation(
    fields: [ipoId],
    references: [id]
  )

  account Account @relation(
    fields: [accountId],
    references: [id]
  )


  @@unique([ipoId, accountId])

  @@index([accountId])

  @@index([ipoId])

  @@map("ipo_applications")
}

enum IpoStatus {
  DRAFT
  OPEN
  CLOSED
  ALLOTMENT_DONE
}

enum IpoApplicationStatus {
  PENDING
  ALLOCATED
  REJECTED
  COMPLETED
}

enum IpoPaymentStatus {
  PENDING
  PAID
  FAILED
}
