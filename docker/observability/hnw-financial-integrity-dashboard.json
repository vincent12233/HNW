    {"type":"stat","title":"Dead outbox events","targets":[{"expr":"hnw_operational_gauge{metric=\"outbox_dead_events\"}"}],"gridPos":{"h":8,"w":8,"x":16,"y":0}},
    {"type":"timeseries","title":"Reconciliation executions","targets":[{"expr":"rate(hnw_operational_counters_total{event=~\"reconciliation_.*\"}[15m])","legendFormat":"{{event}}"}],"gridPos":{"h":9,"w":12,"x":0,"y":8}},
    {"type":"timeseries","title":"Outbox processing","targets":[{"expr":"rate(hnw_operational_counters_total{event=~\"outbox_.*\"}[15m])","legendFormat":"{{event}}"}],"gridPos":{"h":9,"w":12,"x":12,"y":8}}
