# Shared template. For production, build FIVE separate admin deployments.
# NEXT_PUBLIC_* values are inlined at `next build` time — set them BEFORE build.

NEXT_PUBLIC_API_URL=http://localhost:3000

# Required on HTTPS domains (port-based role detection only works on localhost).
# One of: ADMIN | MANAGER | FINANCE | BUSINESS | SUPPORT
NEXT_PUBLIC_BACKEND_ROLE=
