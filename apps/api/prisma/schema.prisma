generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                @id @default(uuid())
  email                      String                @unique
  passwordHash               String
  clientTier                 String                @default("STANDARD")
  avatarData                 String?
  twoFactor                  TwoFactorCredential?
  withdrawalPinHash          String?
  withdrawalPinAttempts      Int                   @default(0)
  withdrawalPinLockedUntil   DateTime?
  transactionKeyHash        String?
  googleSubject             String?               @unique
  authVersion               Int                   @default(0)
  fullName                   String
  phone                      String?               @unique
  customerNo                 String?               @unique
  role                       UserRole              @default(CLIENT)
  status                     UserStatus            @default(ACTIVE)
  deletedAt                  DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  assignedBusinessId         String?
  createdBusinessUsers       User[]                @relation("BusinessCreators")
  businessCreatorId          String?
  businessCreator            User?                 @relation("BusinessCreators", fields: [businessCreatorId], references: [id])
  createdAccountTransactions AccountTransaction[]  @relation("TransactionCreator")
  account                    Account?
  auditLogs                  AuditLog[]
  businessProfile            BusinessProfile?
  usedInviteCodeId           String?
  usedInviteCode             InviteCode?           @relation("InviteCodeCustomers", fields: [usedInviteCodeId], references: [id])
  loginAudits                LoginAudit[]
  supportConversations       SupportConversation[]
  supportMessages            SupportMessage[]
  assignedBusiness           User?                 @relation("BusinessCustomers", fields: [assignedBusinessId], references: [id])
  assignedCustomers          User[]                @relation("BusinessCustomers")
  reviewedOtcOrders          OtcOrder[]             @relation("OtcReviewer")
  bankAccounts               BankAccount[]
  preferences                UserPreference?
  notifications              Notification[]
  devices                    UserDevice[]
  passwordResetCodes         PasswordResetCode[]
  requestedApprovals         ApprovalRequest[]     @relation("ApprovalRequester")
  decidedApprovals           ApprovalRequest[]     @relation("ApprovalDecider")
  insightArticlesCreated     InsightArticle[]      @relation("InsightArticleCreator")
  insightArticlesUpdated     InsightArticle[]      @relation("InsightArticleUpdater")
  announcementsCreated       Announcement[]        @relation("AnnouncementCreator")
  announcementsUpdated       Announcement[]        @relation("AnnouncementUpdater")
  appClientSettingsUpdated   AppClientSetting[]    @relation("AppClientSettingUpdater")
  watchlistItems             UserWatchlistItem[]
  vipTierConfigurationsUpdated VipTierConfiguration[] @relation("VipTierConfigUpdater")
  vipTierChanges             VipTierHistory[]      @relation("VipTierSubject")
  vipTierAdjustmentsMade     VipTierHistory[]      @relation("VipTierChanger")
  assignmentHistoriesAsBusiness BusinessManagerAssignmentHistory[] @relation("AssignmentBusiness")
  assignmentHistoriesAsPrevious BusinessManagerAssignmentHistory[] @relation("AssignmentPreviousManager")
  assignmentHistoriesAsNew      BusinessManagerAssignmentHistory[] @relation("AssignmentNewManager")
  assignmentHistoriesChanged    BusinessManagerAssignmentHistory[] @relation("AssignmentChangedBy")

  @@index([assignedBusinessId])
  @@index([businessCreatorId])
  @@index([usedInviteCodeId])
  @@map("users")
}

model TwoFactorCredential {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String?
  pendingSecret String?
  pendingExpiresAt DateTime?
  enabled Boolean @default(false)
  lastStep Int @default(-1)
  recoveryHashes String[] @default([])
  attempts Int @default(0)
  lockedUntil DateTime?
  @@map("two_factor_credentials")
}

model BusinessProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  employeeNo  String       @unique
  department  String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteCodes InviteCode[]

  @@map("business_profiles")
}

model InviteCode {
  id                String           @id @default(uuid())
  code              String           @unique
  businessProfileId String
  status            InviteCodeStatus @default(UNUSED)
  expiresAt         DateTime?
  usedAt            DateTime?
  disabledAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  businessProfile   BusinessProfile  @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  customers         User[]           @relation("InviteCodeCustomers")

  @@index([businessProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("invite_codes")
}

model Account {
  id                 String               @id @default(uuid())
  accountNumber      String               @unique
  cashBalance        Decimal              @default(0) @db.Decimal(18, 2)
  buyingPower        Decimal              @default(0) @db.Decimal(18, 2)
  currency           String               @default("INR")
  isLive          Boolean              @default(true)
  userId             String               @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  frozenBalance      Decimal              @default(0) @db.Decimal(18, 2)
  depositRequests    DepositRequest[]
  ipoApplications    IpoApplication[]
  transactions       AccountTransaction[]
  loanApplications    LoanApplication[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  ipoDebts           IpoDebt[]
  orders             Order[]
  positions          Position[]
  trades             Trade[]
  withdrawalRequests WithdrawalRequest[]
  otcOrders          OtcOrder[]
  portfolioSnapshots PortfolioSnapshot[]

  @@map("accounts")
}

model AccountTransaction {
  id             String                   @id @default(uuid())
  accountId      String
  type           AccountTransactionType
  status         AccountTransactionStatus @default(PENDING)
  amount         Decimal                  @db.Decimal(18, 2)
  balanceBefore  Decimal                  @db.Decimal(18, 2)
  balanceAfter   Decimal                  @db.Decimal(18, 2)
  referenceId    String?
  idempotencyKey String?                  @unique
  note           String?
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  account        Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy      User?                    @relation("TransactionCreator", fields: [createdById], references: [id])

  @@index([accountId, createdAt])
  @@index([status])
  @@index([referenceId])
  @@map("account_transactions")
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  action        String
  resource      String
  resourceId    String
  payload       Json
  reason        String
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decisionNote  String?
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?
  expiresAt     DateTime?
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([resource, resourceId])
  @@index([requestedById])
  @@map("approval_requests")
}

model Instrument {
  id             String         @id @default(uuid())
  symbol         String
  exchange       Exchange
  name           String
  isin           String?
  logoUrl        String?
  category       String?
  displayOrder   Int            @default(0)
  /// Home surface featured flag (does not duplicate catalog data).
  featuredHome   Boolean        @default(false)
  /// Markets surface featured flag (does not duplicate catalog data).
  featuredMarkets Boolean       @default(false)
  type           InstrumentType @default(EQUITY)
  currency       String         @default("INR")
  lotSize        Int            @default(1)
  tickSize       Decimal        @default(0.05) @db.Decimal(10, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  quote          MarketQuote?
  orders         Order[]
  positions      Position[]
  trades         Trade[]
  otcOffer       OtcOffer?
  otcOrders      OtcOrder[]
  ipos           Ipo[]
  watchlistItems UserWatchlistItem[]

  @@unique([exchange, symbol])
  @@index([symbol])
  @@index([isin])
  @@index([isActive])
  @@index([displayOrder])
  @@index([featuredHome, displayOrder])
  @@index([featuredMarkets, displayOrder])
  @@map("instruments")
}

model MarketQuote {
  id            String     @id @default(uuid())
  instrumentId  String     @unique
  lastPrice     Decimal    @db.Decimal(18, 4)
  openPrice     Decimal?   @db.Decimal(18, 4)
  highPrice     Decimal?   @db.Decimal(18, 4)
  lowPrice      Decimal?   @db.Decimal(18, 4)
  previousClose Decimal?   @db.Decimal(18, 4)
  bidPrice      Decimal?   @db.Decimal(18, 4)
  askPrice      Decimal?   @db.Decimal(18, 4)
  volume        BigInt     @default(0)
  source        String     @default("LIVE_FEED")
  asOf          DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([asOf])
  @@map("market_quotes")
}

model Order {
  id               String      @id @default(uuid())
  clientOrderId    String
  accountId        String
  instrumentId     String
  side             OrderSide
  type             OrderType
  status           OrderStatus @default(PENDING)
  quantity         Int
  filledQuantity   Int         @default(0)
  limitPrice       Decimal?    @db.Decimal(18, 4)
  averageFillPrice Decimal?    @db.Decimal(18, 4)
  frozenAmount     Decimal     @default(0) @db.Decimal(18, 2)
  rejectionReason  String?
  placedAt         DateTime    @default(now())
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  timeInForce      TimeInForce @default(DAY)
  account          Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument       Instrument  @relation(fields: [instrumentId], references: [id])
  trades           Trade[]

  @@unique([accountId, clientOrderId])
  @@index([accountId, status, placedAt])
  @@index([instrumentId, status])
  @@map("orders")
}

model Trade {
  id           String     @id @default(uuid())
  executionId  String     @unique
  orderId      String
  accountId    String
  instrumentId String
  quantity     Int
  price        Decimal    @db.Decimal(18, 4)
  grossAmount  Decimal    @db.Decimal(18, 2)
  fees         Decimal    @default(0) @db.Decimal(18, 2)
  netAmount    Decimal    @db.Decimal(18, 2)
  executedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id])

  @@index([accountId, executedAt])
  @@index([instrumentId, executedAt])
  @@index([orderId])
  @@map("trades")
}

model Position {
  id             String     @id @default(uuid())
  accountId      String
  instrumentId   String
  quantity       Int        @default(0)
  averagePrice   Decimal    @default(0) @db.Decimal(18, 4)
  realizedPnl    Decimal    @default(0) @db.Decimal(18, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  frozenQuantity Int        @default(0)
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument     Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([accountId, instrumentId])
  @@index([accountId])
  @@map("positions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  resource    String
  resourceId  String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model BusinessManagerAssignmentHistory {
  id                         String   @id @default(uuid())
  businessUserId             String
  previousManagerId          String?
  newManagerId               String?
  reason                     String
  changedById                String
  idempotencyKey             String   @unique
  businessEmployeeNo         String?
  previousManagerEmployeeNo  String?
  newManagerEmployeeNo       String?
  clientCountAtChange        Int      @default(0)
  createdAt                  DateTime @default(now())
  businessUser               User     @relation("AssignmentBusiness", fields: [businessUserId], references: [id], onDelete: Restrict)
  previousManager            User?    @relation("AssignmentPreviousManager", fields: [previousManagerId], references: [id], onDelete: Restrict)
  newManager                 User?    @relation("AssignmentNewManager", fields: [newManagerId], references: [id], onDelete: Restrict)
  changedBy                  User     @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([businessUserId, createdAt])
  @@index([previousManagerId, createdAt])
  @@index([newManagerId, createdAt])
  @@index([changedById, createdAt])
  @@map("business_manager_assignment_histories")
}

model Ipo {
  id              String           @id @default(uuid())
  symbol          String
  companyName     String
  exchange        Exchange
  issuePrice      Decimal
  lotSize         Int
  totalShares     Int
  availableShares Int
  openDate        DateTime
  closeDate       DateTime
  status          IpoStatus        @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  instrumentId    String?
  instrument      Instrument?      @relation(fields: [instrumentId], references: [id])
  applications    IpoApplication[]

  @@map("ipos")
}

model IpoApplication {
  draftQuantity Int?
  draftPrice Decimal? @db.Decimal(18, 2)
  publishedAt DateTime?
  id                String               @id @default(uuid())
  ipoId             String
  accountId         String
  quantity          Int
  amount            Decimal
  status            IpoApplicationStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  allocatedQuantity Int?
  allocatedPrice    Decimal?             @db.Decimal(18, 2)
  allocatedAmount   Decimal?             @db.Decimal(18, 2)
  paymentStatus     IpoPaymentStatus     @default(PENDING)
  updatedAt         DateTime             @default(now()) @updatedAt
  account           Account              @relation(fields: [accountId], references: [id])
  ipo               Ipo                  @relation(fields: [ipoId], references: [id])
  ipoDebt           IpoDebt?

  @@map("IpoApplication")
}

model IpoDebt {
  id               String         @id @default(uuid())
  accountId        String
  ipoApplicationId String         @unique
  amount           Decimal        @db.Decimal(18, 2)
  paidAmount       Decimal        @default(0) @db.Decimal(18, 2)
  status           IpoDebtStatus  @default(OPEN)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ipoApplication   IpoApplication @relation(fields: [ipoApplicationId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@map("ipo_debts")
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_audits")
}

model SupportConversation {
  id          String           @id @default(uuid())
  clientId    String
  status      SupportStatus    @default(OPEN)
  tags        String[]         @default([])
  internalNote String?
  priority    String           @default("普通")
  assignedToId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  client      User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]

  @@index([clientId])
  @@index([status])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  senderId       String
  senderType     SenderType
  content        String
  attachmentName String?
  attachmentUrl  String?
  attachmentType String?
  readAt          DateTime?
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("support_messages")
}

model BankAccount {
  id            String            @id @default(uuid())
  userId        String
  bankName      String
  accountHolder String
  accountNumber String
  ifscCode      String
  status        BankAccountStatus @default(APPROVED)
  isPrimary     Boolean           @default(false)
  reviewNote    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber, ifscCode])
  @@index([userId, status])
  @@map("bank_accounts")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  orderNotifications Boolean  @default(true)
  accountNotifications Boolean @default(true)
  supportNotifications Boolean @default(true)
  biometricEnabled   Boolean  @default(false)
  language           String   @default("en")
  theme              String   @default("light")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  referenceId String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String
  deviceName  String
  platform    String
  pushToken   String?
  lastIp      String?
  lastSeenAt  DateTime @default(now())
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_devices")
}

model PortfolioSnapshot {
  id          String   @id @default(uuid())
  accountId   String
  cashValue   Decimal  @db.Decimal(18, 2)
  instValue   Decimal  @db.Decimal(18, 2)
  otcValue    Decimal  @db.Decimal(18, 2)
  ipoValue    Decimal  @db.Decimal(18, 2)
  totalValue  Decimal  @db.Decimal(18, 2)
  profitValue Decimal? @db.Decimal(18, 2)
  productProfitValue Decimal? @db.Decimal(18, 2)
  capturedAt  DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
  @@map("portfolio_snapshots")
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_codes")
}

model DepositRequest {
  id            String        @id @default(uuid())
  accountId     String
  amount        Decimal       @db.Decimal(18, 2)
  paymentMethod String?
  referenceId   String?       @unique
  status        DepositStatus @default(PENDING)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status, createdAt])
}

model WithdrawalRequest {
  id            String           @id @default(uuid())
  orderNo       String?          @unique
  accountId     String
  amount        Decimal          @db.Decimal(18, 2)
  frozenAmount  Decimal          @default(0) @db.Decimal(18, 2)
  bankName      String?
  accountNumber String?
  ifscCode      String?
  upiId         String?
  note          String?
  status        WithdrawalStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([orderNo])
  @@map("withdrawal_requests")
}

model AdminWatchlistItem {
  id        String   @id @default(uuid())
  symbol    String
  name      String
  market    String   @default("NSE")
  category  String
  risk      String
  status    String   @default("ACTIVE")
  reason    String?
  direction String   @default("UP")
  expectedReturn Decimal? @db.Decimal(8, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([status])
  @@map("admin_watchlist_items")
}

model OtcOffer {
  id           String    @id @default(uuid())
  instrumentId String    @unique
    price        Decimal   @db.Decimal(18, 4)
    priceTier2   Decimal?  @db.Decimal(18, 4)
    priceTier3   Decimal?  @db.Decimal(18, 4)
    profitTier1  Decimal?  @db.Decimal(8, 2)
    profitTier2  Decimal?  @db.Decimal(8, 2)
    profitTier3  Decimal?  @db.Decimal(8, 2)
    keyHashTier1 String?
    keyHashTier2 String?
    keyHashTier3 String?
    transactionKeyEncrypted String?
  isActive     Boolean   @default(true)
  validFrom    DateTime
  validUntil   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  orders       OtcOrder[]

  @@index([isActive, validFrom, validUntil])
  @@map("otc_offers")
}

model OtcOrder {
  id           String         @id @default(uuid())
  orderNo      String         @unique
  accountId    String
  offerId      String
  instrumentId String
  quantity     Int
    price        Decimal        @db.Decimal(18, 4)
    priceTier    Int            @default(1)
  amount       Decimal        @db.Decimal(18, 2)
  status       OtcOrderStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  offer        OtcOffer       @relation(fields: [offerId], references: [id])
  instrument   Instrument     @relation(fields: [instrumentId], references: [id])
  reviewedBy   User?          @relation("OtcReviewer", fields: [reviewedById], references: [id])

  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@map("otc_orders")
}

model AdminBlockTrade {
  id          String   @id @default(uuid())
  orderNo     String   @unique
  symbol      String
  side        String
  quantity    Int
  price       Decimal  @db.Decimal(18, 4)
  minTicket   Decimal  @db.Decimal(18, 2)
  status      String   @default("审核中")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol])
  @@index([status])
  @@map("admin_block_trades")
}

model AdminFundProduct {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  type         String
  nav          Decimal  @db.Decimal(18, 4)
  minSubscribe Decimal  @db.Decimal(18, 2)
  risk         String
  status       String   @default("开放申购")
  manager      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("admin_fund_products")
}

model AdminQuantStrategy {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  market            String
  risk              String
  annualReturn      Decimal  @db.Decimal(8, 2)
  maxDrawdown       Decimal  @db.Decimal(8, 2)
  authorizedClients Int      @default(0)
  status            String   @default("观察中")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@map("admin_quant_strategies")
}

enum UserRole {
  ADMIN
  MANAGER
  BUSINESS
  CLIENT
  SUPPORT
  FINANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountTransactionType {
  DEPOSIT
  WITHDRAWAL
  ADMIN_CREDIT
  ADMIN_DEBIT
  ORDER_FREEZE
  ORDER_RELEASE
  TRADE_SETTLEMENT
  IPO_REPAYMENT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  OTC_SETTLEMENT
}

enum OtcOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountTransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
