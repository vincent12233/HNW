# Copy this file to .env.docker and set five different strong passwords.
# The real file is ignored by Git.
NODE_ENV=development
CORS_ORIGINS=http://localhost:3002

JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
OTC_KEY_ENCRYPTION_SECRET=replace-with-a-different-random-value-of-at-least-32-characters
OBJECT_SIGNING_SECRET=replace-with-a-third-random-value-of-at-least-32-characters

ADMIN_INITIAL_PASSWORD=
FINANCE_INITIAL_PASSWORD=
MANAGER_INITIAL_PASSWORD=
SUPPORT_INITIAL_PASSWORD=
BUSINESS_INITIAL_PASSWORD=
