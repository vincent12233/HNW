# TrueData streaming is optional. Keep streaming disabled to use polling-only mode.
MARKET_DATA_STREAMING_ENABLED=true
MARKET_DATA_STREAMING_PROVIDER=TRUEDATA

# TrueData account credentials
TRUEDATA_USER=
TRUEDATA_PASSWORD=

# TrueData runtime transport settings
TRUEDATA_PORT=8082
TRUEDATA_BIDASK=true
TRUEDATA_HEARTBEAT=true
TRUEDATA_REPLAY=false
TRUEDATA_URL=push

# Install the optional runtime SDK before enabling TrueData:
# npm install truedata-nodejs@1.2.0
