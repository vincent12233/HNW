DATABASE_URL="postgresql://hnw_user:hnw_dev_password@localhost:5432/hnw_trading?schema=public"
SHADOW_DATABASE_URL="postgresql://hnw_user:hnw_dev_password@localhost:5432/hnw_trading_shadow?schema=public"

# Use a long random secret in production.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated origins allowed to call the API.
# Example: https://admin.example.com,https://app.example.com
CORS_ORIGINS="http://localhost:3002,http://localhost:3001,http://localhost:3000"

PORT=3000
MATCHING_MAX_FILL_QUANTITY=1000
UPSTOX_ACCESS_TOKEN=

# NSE equity normal-market lifecycle (IST).
MARKET_OPEN_TIME_IST=09:15
MARKET_CLOSE_TIME_IST=15:30
# Maintain this comma-separated YYYY-MM-DD list from the exchange holiday calendar.
MARKET_HOLIDAYS_IST=
DAY_ORDER_EXPIRY_BATCH_SIZE=500

# Snapshot / polling market data provider.
MARKET_DATA_PROVIDER=YAHOO
# Maximum active ordinary stocks refreshed in each 30-second polling cycle.
# Holdings and active-order symbols are prioritized; remaining symbols rotate
# by least-recent polling attempt so large enabled catalogs stay bounded.
MARKET_DATA_POLL_BATCH_SIZE=40

# Streaming market data remains disabled by default. When enabled, stale or
# unavailable streaming data automatically falls back to the polling provider.
MARKET_DATA_STREAMING_ENABLED=false
MARKET_DATA_STREAMING_PROVIDER=NONE
MARKET_DATA_RECONNECT_MS=5000
MARKET_DATA_STALE_AFTER_MS=60000

# TrueData streaming configuration.
# Install the optional official truedata-nodejs SDK before selecting TRUEDATA.
TRUEDATA_USER=
TRUEDATA_PASSWORD=
TRUEDATA_PORT=8082
TRUEDATA_URL=push
TRUEDATA_BIDASK=true
TRUEDATA_HEARTBEAT=true
TRUEDATA_REPLAY=false
TRUEDATA_SYMBOL_LIMIT=200
TRUEDATA_SUBSCRIBE_BATCH_SIZE=50
