# Local editor state
.idea/
.agents/
.claude/
.windsurf/
apps/**/.agents/
apps/**/.claude/
apps/**/.windsurf/

# Local runtime logs
*.log
*-local.log
*-local.err.log

# Local environment and uploaded customer files
.env
.env.*
!.env.example
!.env.docker.example
apps/**/.env
apps/**/.env.*
!apps/**/.env.example
apps/api/uploads/
apps/api/private-objects/
apps/api/private-objects/

# Local Flutter/Node helper caches used during checks
.pub-cache/
.flutter-appdata/
.flutter-localappdata/
.dart-appdata/
.dart-localappdata/
.dart-state/
.tool-state/
.local/
.codex-gitconfig
.gradle-cache/
apps/client/.gradle-final/

# Flutter generated metadata and local release artifacts
apps/client/.dart_tool/
apps/client/.flutter-plugins
apps/client/.flutter-plugins-dependencies
*.apk
*.aab

# Android signing credentials
*.jks
*.keystore
apps/client/android/key.properties

# Dependency and build output fallbacks for workspace-level status
node_modules/
.next/
.next-*/
dist/
build/
coverage/
backups/

# Local visual verification captures and accidental Windows cache folder
artifacts/
%SystemDrive%/
