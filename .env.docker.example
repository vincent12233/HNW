# Copy this file to .env.docker and set five different strong passwords.
# The real file is ignored by Git.
NODE_ENV=development
CORS_ORIGINS=http://localhost:3002,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://192.168.1.150:3002,http://192.168.1.150:3004,http://192.168.1.150:3005,http://192.168.1.150:3006,http://192.168.1.150:3007

JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
# Use a separate stable random secret in production; local fallback is JWT_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=
OTC_KEY_ENCRYPTION_SECRET=replace-with-a-different-random-value-of-at-least-32-characters
OBJECT_SIGNING_SECRET=replace-with-a-third-random-value-of-at-least-32-characters

ADMIN_INITIAL_PASSWORD=
FINANCE_INITIAL_PASSWORD=
MANAGER_INITIAL_PASSWORD=
SUPPORT_INITIAL_PASSWORD=
BUSINESS_INITIAL_PASSWORD=

# URL of a trusted BSE equity-only CSV with SECURITY CODE, SECURITY NAME and ISIN columns.
BSE_EQUITY_MASTER_URL=

# Free test providers. Elbstream requires visible linked attribution in the App.
STOCK_LOGO_PROVIDER=elbstream
STOCK_LOGO_BASE_URL=https://api.elbstream.com/logos/isin
# rss disables GDELT; auto combines GDELT and existing RSS with a 5 minute cache.
MARKET_NEWS_PROVIDER=auto
MARKET_NEWS_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
