model LoanApplication {
  id             String     @id @default(uuid())
  orderNo        String     @unique
  accountId      String
  requestedAmount Decimal   @db.Decimal(18, 2)
  approvedAmount  Decimal?  @db.Decimal(18, 2)
  outstandingAmount Decimal @default(0) @db.Decimal(18, 2)
  interestRate   Decimal    @default(0) @db.Decimal(8, 2)
  dueDate        DateTime?
  status         LoanStatus @default(PENDING)
  note           String?
  approvedById   String?
  approvedAt     DateTime?
  disbursedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([orderNo])
  @@index([status])
  @@map("loan_applications")
}

model CompanyShowcase {
  id          String   @id @default(uuid())
  name        String
  tagline     String
  description String
  logoUrl     String?
  videoUrl    String?
  websiteUrl  String?
  sector      String?
  status      String   @default("ACTIVE")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
  @@map("company_showcases")
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  PARTIAL_REPAID
  REPAID
  OVERDUE
}

enum AppContentModule {
  HOME
  DEPOSIT
  SUPPORT
  TRADING
  LEGAL
  ABOUT
  INSIGHTS
}

model AppContentEntry {
  id        String           @id @default(uuid())
  module    AppContentModule
  key       String
  title     String?
  body      String           @db.Text
  locale    String           @default("en")
  metadata  Json?
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([module, key, locale])
  @@index([module, isActive])
  @@index([module, sortOrder])
  @@map("app_content_entries")
}

/// Structured Wealth Insights articles (replaces fixed article.01–08 KV over time).
/// Legacy AppContentEntry INSIGHTS keys remain as temporary fallback.
model InsightArticle {
  id          String    @id @default(uuid())
  slug        String
  locale      String    @default("en")
  title       String
  summary     String?   @db.Text
  body        String    @db.Text
  imageUrl    String?
  isPublished Boolean   @default(false)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?     @relation("InsightArticleCreator", fields: [createdById], references: [id])
  updatedBy   User?     @relation("InsightArticleUpdater", fields: [updatedById], references: [id])

  @@unique([slug, locale])
  @@index([isPublished, sortOrder])
  @@index([locale, isPublished])
  @@map("insight_articles")
}

enum AnnouncementType {
  GENERAL
  MAINTENANCE
  IMPORTANT
  MARKET_NOTICE
}

/// Platform ops announcements — distinct from Market News RSS and Home/Markets banners.
model Announcement {
  id          String           @id @default(uuid())
  locale      String           @default("en")
  title       String
  body        String           @db.Text
  type        AnnouncementType @default(GENERAL)
  isPublished Boolean          @default(false)
  priority    Int              @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?            @relation("AnnouncementCreator", fields: [createdById], references: [id])
  updatedBy   User?            @relation("AnnouncementUpdater", fields: [updatedById], references: [id])

  @@index([isPublished, sortOrder])
  @@index([locale, isPublished])
  @@index([startsAt, endsAt])
  @@map("announcements")
}

enum AppClientPlatform {
  ANDROID
  IOS
  WEB
}

/// Per-platform client gates (maintenance / version). Not marketing About.app_version.
model AppClientSetting {
  id                 String            @id @default(uuid())
  platform           AppClientPlatform @unique
  minVersion         String            @default("0.0.0")
  latestVersion      String            @default("0.0.0")
  forceUpdate        Boolean           @default(false)
  maintenanceMode    Boolean           @default(false)
  maintenanceMessage String?           @db.Text
  supportUrl         String?
  /// Client update destination (Play Store / App Store / web download). Optional; http/https only.
  updateUrl          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  updatedById        String?
  updatedBy          User?             @relation("AppClientSettingUpdater", fields: [updatedById], references: [id])

  @@map("app_client_settings")
}

/// Existing KYC table alignment (created by prior SQL migrations).
/// Raw SQL KYC service paths may remain; this does not change KYC UX/flow.
model KycSubmission {
  id                String    @id @default(uuid())
  userId            String
  businessUserId    String
  documentType      String
  status            String    @default("PENDING")
  fileName          String
  filePath          String
  mimeType          String?
  recognizedType    String?
  recognizedText    String?
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  backFileName      String?
  backFilePath      String?
  backMimeType      String?
  selfieFilePath    String?
  selfieMimeType    String?
  signatureFilePath String?
  fullName          String?
  bankDetails       Json?

  @@index([userId])
  @@index([businessUserId, status])
  @@map("kyc_submissions")
}

/// Super-admin VIP display/recommendation thresholds. Never auto-writes User.clientTier.
model VipTierConfiguration {
  id                       String    @id @default(uuid())
  tierCode                 String    @unique
  displayName              String
  description              String    @default("")
  minimumCumulativeDeposit Decimal?  @db.Decimal(18, 2)
  displayOrder             Int       @unique
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  updatedById              String?
  updatedBy                User?     @relation("VipTierConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("vip_tier_configurations")
}

/// Manual VIP membership changes. Suggestion snapshots are display-only.
model VipTierHistory {
  id                        String   @id @default(uuid())
  userId                    String
  previousTier              String
  newTier                   String
  reason                    String
  source                    String
  suggestedTierAtChange     String?
  cumulativeDepositAtChange Decimal  @db.Decimal(18, 2)
  changedById               String
  createdAt                 DateTime @default(now())
  user                      User     @relation("VipTierSubject", fields: [userId], references: [id], onDelete: Restrict)
  changedBy                 User     @relation("VipTierChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([changedById, createdAt])
  @@index([newTier, createdAt])
  @@map("vip_tier_histories")
}

/// Existing client watchlist table alignment (created by prior SQL migrations).
model UserWatchlistItem {
  id           String     @id @default(uuid())
  userId       String
  instrumentId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
  @@index([userId, createdAt])
  @@map("user_watchlist_items")
}


